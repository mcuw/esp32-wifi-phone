# --- Target / flash -------------------------------------------------
CONFIG_IDF_TARGET="esp32c6"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_OFFSET=0xF000
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_FREERTOS_HZ=1000

# --- Wi-Fi 6 / iTWT ---------------------------------------------------
# HE (11ax) is enabled at runtime via esp_wifi_set_protocol().
# PM must be enabled for modem sleep / TWT to save power.
CONFIG_PM_ENABLE=y
CONFIG_ESP_WIFI_ENABLE_WIFI_TX_STATS=y
CONFIG_ESP_WIFI_ENABLE_WIFI_RX_STATS=y

# --- Sockets: HTTP (static UI + API), DNS, call signalling, mDNS ---
CONFIG_LWIP_MAX_SOCKETS=16

# --- Firmware-Update (OTA, Issue #16) ---------------------------------
# Neue Firmware startet als "pending verify" und meldet sich erst als gültig,
# wenn WLAN und Signalisierung laufen (main/ota.c). Sonst nimmt der Bootloader
# die vorherige. Steckt im Bootloader: einmal per USB flashen, OTA ändert ihn nicht.
# Kein Anti-Rollback und kein Secure Boot: beides brennt eFuses (erst bei Auslieferung).
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# --- Core dump: bei Absturz ELF-Abbild in Partition "coredump" schreiben
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y
CONFIG_ESP_COREDUMP_DATA_FORMAT_ELF=y

# --- Memory: no PSRAM on this board, be careful -------------------------
CONFIG_ESP_MAIN_TASK_STACK_SIZE=6144

# --- Size: LVGL auf das Nötige reduzieren -----------------------------
# ui.c nutzt nur obj, label, button, list (→ image, flex) und slider (→ bar).
CONFIG_LV_BUILD_EXAMPLES=n
CONFIG_LV_BUILD_DEMOS=n
CONFIG_LV_USE_THEME_SIMPLE=n
CONFIG_LV_USE_THEME_MONO=n
CONFIG_LV_USE_GRID=n
CONFIG_LV_USE_ANIMIMG=n
CONFIG_LV_USE_ARC=n
CONFIG_LV_USE_ARCLABEL=n
CONFIG_LV_USE_BUTTONMATRIX=n
CONFIG_LV_USE_CALENDAR=n
CONFIG_LV_USE_CANVAS=n
CONFIG_LV_USE_CHART=n
CONFIG_LV_USE_CHECKBOX=n
CONFIG_LV_USE_DROPDOWN=n
CONFIG_LV_USE_IMAGEBUTTON=n
CONFIG_LV_USE_KEYBOARD=n
CONFIG_LV_USE_LED=n
CONFIG_LV_USE_LINE=n
CONFIG_LV_USE_MENU=n
CONFIG_LV_USE_MSGBOX=n
CONFIG_LV_USE_ROLLER=n
CONFIG_LV_USE_SCALE=n
CONFIG_LV_USE_SPAN=n
CONFIG_LV_USE_SPINBOX=n
CONFIG_LV_USE_SPINNER=n
CONFIG_LV_USE_SWITCH=n
CONFIG_LV_USE_TEXTAREA=n
CONFIG_LV_USE_TABLE=n
CONFIG_LV_USE_TABVIEW=n
CONFIG_LV_USE_TILEVIEW=n
CONFIG_LV_USE_WIN=n

# --- Display-Puffer: RAM für TLS (Issue #16) ---------------------------
# Der BSP legt einen LVGL-Zeichenpuffer von 410 x BUF_HEIGHT Pixeln an und
# wegen sw_rotate einen zweiten gleich großen. Bei 100 Zeilen sind das 164 KB
# internes RAM (kein PSRAM), und für TLS zu GitHub blieben ~43 KB frei, zu wenig.
# 40 Zeilen: 66 KB, die Oberfläche zeichnet in mehr, kleineren Streifen.
CONFIG_BSP_DISPLAY_LVGL_BUF_HEIGHT=40

# --- Schrift: 14 px ist auf dem 2,06"-AMOLED kaum lesbar ----------------
# Standard 20 px; ui.c nutzt 28 (FONT_MID) und 36 (FONT_BIG).
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_MONTSERRAT_28=y
CONFIG_LV_FONT_MONTSERRAT_36=y
CONFIG_LV_FONT_DEFAULT_MONTSERRAT_20=y
